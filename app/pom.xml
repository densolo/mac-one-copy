    <build>
        <finalName>mac-one-copy-app</finalName>
        <plugins>
            <!-- Compose Multiplatform has no Maven plugin: hand the Compose compiler plugin to kotlinc directly. -->
            <plugin>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>compose-compiler</id>
                        <phase>initialize</phase>
                        <goals><goal>copy</goal></goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.jetbrains.kotlin</groupId>
                                    <artifactId>kotlin-compose-compiler-plugin-embeddable</artifactId>
                                    <version>${kotlin.version}</version>
                                    <destFileName>kotlin-compose-compiler-plugin-embeddable.jar</destFileName>
                                </artifactItem>
                                <!-- Also fetched so the `idea` profile finds it in the local repository. -->
                                <artifactItem>
                                    <groupId>org.jetbrains.kotlin</groupId>
                                    <artifactId>kotlin-compose-compiler-plugin</artifactId>
                                    <version>${kotlin.version}</version>
                                    <destFileName>kotlin-compose-compiler-plugin.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}/compose-compiler</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <configuration>
                    <args combine.children="append">
                        <arg>-Xplugin=${compose.plugin.jar}</arg>
                    </args>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                    <manifestEntries>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/versions/9/module-info.class</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Active only inside IntelliJ, which sets idea.maven.embedder.version when it imports the project. -->
        <profile>
            <id>idea</id>
            <activation>
                <property><name>idea.maven.embedder.version</name></property>
            </activation>
            <properties>
                <compose.plugin.jar>${user.home}/.m2/repository/org/jetbrains/kotlin/kotlin-compose-compiler-plugin/${kotlin.version}/kotlin-compose-compiler-plugin-${kotlin.version}.jar</compose.plugin.jar>
            </properties>
        </profile>
        <!-- ./mvnw -pl app -am package -Papp-image  →  app/target/dist/mac-one-copy.app -->
        <profile>
            <id>app-image</id>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>jpackage-input</id>
                                <phase>package</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes><include>mac-one-copy-app.jar</include></includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.8.0</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <name>mac-one-copy</name>
                                    <!-- macOS requires the first version number to be at least 1 -->
                                    <appVersion>1.0.0</appVersion>
                                    <type>APP_IMAGE</type>
                                    <input>${project.build.directory}/jpackage-input</input>
                                    <mainJar>mac-one-copy-app.jar</mainJar>
                                    <mainClass>${main.class}</mainClass>
                                    <destination>${project.build.directory}/dist</destination>
                                    <removeDestination>true</removeDestination>
                                    <macPackageIdentifier>app.dc8.maconecopy</macPackageIdentifier>
                                    <!-- Regenerate with tools/icon/make-icns.sh -->
                                    <icon>${project.basedir}/src/main/packaging/mac-one-copy.icns</icon>
                                    <javaOptions>
                                        <option>--enable-native-access=ALL-UNNAMED</option>
                                    </javaOptions>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
